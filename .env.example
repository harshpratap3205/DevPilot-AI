# Environment Configuration for DevPilot AI

# Server & Runtime
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# PostgreSQL (pgvector enabled)
DATABASE_URL=postgresql://devpilot:devpilot_secret@localhost:5432/devpilot_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Session & Security
SESSION_SECRET=devpilot_super_secret_session_key_min_32_chars_123456
CSRF_SECRET=devpilot_csrf_secret_min_32_characters_random_string

# GitHub Integration (Phase 1)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY_PATH=./keys/github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# AI & LLM Provider (Phase 3)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
