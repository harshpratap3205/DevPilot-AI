{
  "name": "devpilot-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter \"@devpilot/*\" --parallel dev",
    "build": "pnpm --filter \"@devpilot/*\" build",
    "test": "pnpm --filter \"@devpilot/*\" test",
    "lint": "pnpm --filter \"@devpilot/*\" lint",
    "typecheck": "pnpm --filter \"@devpilot/*\" typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
